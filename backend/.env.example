# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/event_booking
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/event_booking
MONGO_URI=mongodb://127.0.0.1:27017/event_booking

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_URL=https://full-stack-event-management-frontend.onrender.com

# Optional SMTP notifications. Gmail requires an app password; Mailtrap is useful for testing.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=CampusEvents <no-reply@example.com>
